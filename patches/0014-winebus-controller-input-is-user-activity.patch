 /* Buttons as hid_device_add_gamepad numbers them (the SDL bus's order). */
 enum { PAD_A, PAD_B, PAD_X, PAD_Y, PAD_LB, PAD_RB, PAD_BACK, PAD_START, PAD_LS, PAD_RS,
        PAD_UP, PAD_RIGHT, PAD_DOWN, PAD_LEFT, PAD_GUIDE = 16 };
+
+/* Tells macOS someone is using the Mac, as the keyboard and trackpad do, so
+ * the display doesn't dim while the pad is played: macOS doesn't see input
+ * read straight from a USB device. Only real use counts (a button, a trigger
+ * pulled, a stick moved past its jitter), at most every few seconds. */
+static void gip_declare_activity(const UInt8 *data)
+{
+    static UInt8 last[18];
+    static IOPMAssertionID assertion = kIOPMNullAssertionID;
+    static time_t declared;
+    time_t now = time(NULL);
+    unsigned int i;
+    BOOL used = data[4] != last[4] || data[5] != last[5];
+
+    for (i = 6; i < 10 && !used; i += 2)
+        used = abs((data[i] | data[i + 1] << 8) - (last[i] | last[i + 1] << 8)) > 64;
+    for (i = 10; i < 18 && !used; i += 2)
+        used = abs((SHORT)(data[i] | data[i + 1] << 8) - (SHORT)(last[i] | last[i + 1] << 8)) > 4096;
+    if (!used) return;
+    memcpy(last, data, sizeof(last));
+    if (now - declared < 5) return;
+    declared = now;
+    IOPMAssertionDeclareUserActivity(CFSTR("Wine: game controller in use"), kIOPMUserActiveLocal,
+                                     &assertion);
+}
 
