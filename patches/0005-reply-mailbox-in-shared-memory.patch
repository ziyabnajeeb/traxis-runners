+/* Traxis (patches/0005): gives the calling thread a reply mailbox, shared
+ * memory the server maps too. Without one, replies use the pipe only. */
+static void init_reply_mailbox(void)
+{
+    static LONG counter;
+    struct reply_mailbox *mailbox;
+    unsigned int status;
+    char name[32];
+    int fd;
+
+    if (!reply_mailbox_spin_ns()) return;
+    snprintf( name, sizeof(name), "/wmbx.%x.%x", (unsigned int)getpid(),
+              (unsigned int)InterlockedIncrement( &counter ) );
+    if ((fd = shm_open( name, O_RDWR | O_CREAT | O_EXCL, 0600 )) == -1) return;
+    shm_unlink( name );
+    if (ftruncate( fd, sizeof(*mailbox) ) == -1 ||
+        (mailbox = mmap( NULL, sizeof(*mailbox), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+    {
+        close( fd );
+        return;
+    }
+    wine_server_send_fd( fd );
+    SERVER_START_REQ( set_reply_mailbox )
+    {
+        req->fd   = fd;
+        req->size = sizeof(*mailbox);
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    close( fd );
+    if (status) munmap( mailbox, sizeof(*mailbox) );
+    else reply_mailbox = mailbox;
+}
