+/*
+ * Traxis (patches/0005): a per-thread page shared by a client thread and the
+ * wineserver, where the server writes a reply while the thread spins for it.
+ *
+ * A server round trip through the reply pipe costs ~10 us on macOS, mostly
+ * putting the client thread to sleep and waking it up; most replies are ready
+ * within microseconds. The client marks the mailbox SPINNING before sending a
+ * request and spins on it for a short while. If the server replies while the
+ * client is still spinning, it moves SPINNING -> WRITING, copies the reply
+ * here and sets READY; the client copies it out and sets IDLE. If the client
+ * stops spinning first, it moves SPINNING -> GAVE_UP and reads the reply
+ * pipe as before, where the server then writes the reply. Each move is a
+ * compare-and-swap, so every reply goes exactly one way.
+ */
+
+#ifndef __WINE_WINE_REPLY_MAILBOX_H
+#define __WINE_WINE_REPLY_MAILBOX_H
+
+#include <wine/server_protocol.h>
+
+enum reply_mailbox_state
+{
+    REPLY_MAILBOX_IDLE,
+    REPLY_MAILBOX_SPINNING,  /* client waits here for its reply */
+    REPLY_MAILBOX_WRITING,   /* server is copying the reply in */
+    REPLY_MAILBOX_READY,     /* reply is here */
+    REPLY_MAILBOX_GAVE_UP    /* client reads the reply pipe instead */
+};
+
+#define REPLY_MAILBOX_SIZE 16384
+
+struct reply_mailbox
+{
+    int                 state;  /* enum reply_mailbox_state, accessed atomically */
+    int                 pad;
+    union generic_reply reply;  /* the reply header */
+    char                data[REPLY_MAILBOX_SIZE - 8 - sizeof(union generic_reply)];  /* reply data */
+};
+
+#endif  /* __WINE_WINE_REPLY_MAILBOX_H */
