+static long long reply_mailbox_spin = -1;  /* ns; 0 turns the mailbox off */
+
+static long long reply_mailbox_spin_ns(void)
+{
+    if (reply_mailbox_spin < 0)
+    {
+        const char *env = getenv( "WINE_REPLY_MAILBOX_SPIN_US" );
+        reply_mailbox_spin = (env ? atoll( env ) : 20) * 1000;
