+/* Traxis (patches/0005): map the calling thread's reply mailbox */
+DECL_HANDLER(set_reply_mailbox)
+{
+    int fd = thread_get_inflight_fd( current, req->fd );
+    void *ptr;
+
+    if (fd == -1)
+    {
+        set_error( STATUS_INVALID_HANDLE );
+        return;
+    }
+    if (req->size != sizeof(struct reply_mailbox))
+    {
+        close( fd );
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    ptr = mmap( NULL, req->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    close( fd );
+    if (ptr == MAP_FAILED)
+    {
+        file_set_error();
+        return;
+    }
+    if (current->reply_mailbox) munmap( current->reply_mailbox, sizeof(*current->reply_mailbox) );
+    current->reply_mailbox = ptr;
+}
