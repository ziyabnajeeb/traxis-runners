+static inline void spin_pause(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#elif defined(__aarch64__)
+    __asm__ __volatile__( "yield" );
+#endif
 }
 
+/* Spins until the reply is in the mailbox (TRUE), or gives up and leaves it
+ * to the reply pipe (FALSE). */
+static BOOL wait_reply_mailbox( struct reply_mailbox *mailbox )
+{
+    long long limit = 0;
+    unsigned int i;
 
+    for (i = 0;; i++)
+    {
+        int state = __atomic_load_n( &mailbox->state, __ATOMIC_ACQUIRE );
+
+        if (state == REPLY_MAILBOX_READY) return TRUE;
+        /* while the server is WRITING, wait for it: that takes no time */
+        if (state == REPLY_MAILBOX_SPINNING && !(i & 63))
+        {
+            long long now = monotonic_ns();
+            if (!limit) limit = now + reply_mailbox_spin_ns();
+            else if (now >= limit)
+            {
+                int expected = REPLY_MAILBOX_SPINNING;
+                if (__atomic_compare_exchange_n( &mailbox->state, &expected, REPLY_MAILBOX_GAVE_UP, 0,
+                                                 __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ))
+                    return FALSE;
+            }
+        }
+        spin_pause();
+    }
+}
