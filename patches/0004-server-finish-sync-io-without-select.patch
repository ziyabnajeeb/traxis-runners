--- a/server/async.c
+++ b/server/async.c
@@ -492,6 +492,32 @@
     async->initial_status = async->iosb->status;
     set_error( async->iosb->status );
     return async->wait_handle;
+}
+
+/* Traxis (patches/0004): like async_handoff(), but I/O that completed at once
+ * on a synchronous handle, with no event, APC or completion port to notify,
+ * is finished here and no wait handle is returned. That saves the client a
+ * select request that would only do this; pipes read and written in small
+ * pieces (installers' unpacking helpers) make tens of thousands of these a
+ * second. Only for requests whose client then fills in the IOSB itself
+ * (ntdll's server_read_file and server_write_file). */
+obj_handle_t async_handoff_direct( struct async *async, data_size_t *result, int force_blocking )
+{
+    obj_handle_t handle = async_handoff( async, result, force_blocking );
+    unsigned int status = get_error();
+
+    if (handle && status != STATUS_PENDING && !NT_ERROR( status ) && async->blocking &&
+        async->direct_result && async->terminated && !async->unknown_status &&
+        !async->event && !async->data.apc && !async->data.apc_context)
+    {
+        async_set_result( &async->obj, async->iosb->status, async->iosb->result );
+        async->direct_result = 0;
+        close_handle( async->thread->process, async->wait_handle );
+        async->wait_handle = 0;
+        set_error( status );
+        return 0;
+    }
+    return handle;
 }
 
