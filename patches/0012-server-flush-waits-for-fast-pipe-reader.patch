+static data_size_t pipe_end_get_avail( struct pipe_end *pipe_end );
+
+/* Traxis (patches/0012): the other end of a fast pipe reads the socket
+ * without the server, so a flush waiting for it to read everything checks the
+ * socket every millisecond. A disconnect ends the wait too. */
+static void fast_pipe_flush_check( void *private )
+{
+    struct pipe_end *pipe_end = private;
+
+    pipe_end->flush_timer = NULL;
+    if (!pipe_end->connection) return;
+    if (pipe_end_get_avail( pipe_end->connection ))
+        pipe_end->flush_timer = add_timeout_user( -10000, fast_pipe_flush_check, pipe_end );
+    else
+        fd_async_wake_up( pipe_end->fd, ASYNC_TYPE_WAIT, STATUS_SUCCESS );
 }
 
