+
+/* Traxis (patches/0011): a thread waiting in fast_pipe_wait, which
+ * CancelSynchronousIo and CancelIoEx find here: the I/O doesn't go through
+ * the server, so the server's cancel can't reach it. */
+struct fast_pipe_waiter
+{
+    struct list      entry;
+    HANDLE           tid;
+    HANDLE           handle;
+    IO_STATUS_BLOCK *io;
+    int              wake_fd;
+    BOOL             cancelled;
+};
+
+static struct list fast_pipe_waiters = LIST_INIT( fast_pipe_waiters );
+static pthread_mutex_t fast_pipe_mutex = PTHREAD_MUTEX_INITIALIZER;
+static __thread int fast_pipe_wake[2] = { -1, -1 };
+static __thread struct fast_pipe_waiter *fast_pipe_current;  /* while in the list */
+
+/* Waits until `fd` is ready for `events`, or the I/O is cancelled. */
+static NTSTATUS fast_pipe_wait( HANDLE handle, IO_STATUS_BLOCK *io, int fd, short events )
+{
+    struct fast_pipe_waiter waiter;
+    struct pollfd pfd[2] = { { fd, events, 0 }, { -1, POLLIN, 0 } };
+    sigset_t sigset;
+    char byte;
+
+    if (fast_pipe_wake[0] == -1 && pipe( fast_pipe_wake ) != -1)
+    {
+        fcntl( fast_pipe_wake[0], F_SETFL, O_NONBLOCK );
+        fcntl( fast_pipe_wake[1], F_SETFL, O_NONBLOCK );
+        fcntl( fast_pipe_wake[0], F_SETFD, FD_CLOEXEC );
+        fcntl( fast_pipe_wake[1], F_SETFD, FD_CLOEXEC );
+    }
+    if (fast_pipe_wake[0] == -1)
+    {
+        poll( pfd, 1, -1 );
+        return STATUS_SUCCESS;
+    }
+
+    waiter.tid       = NtCurrentTeb()->ClientId.UniqueThread;
+    waiter.handle    = handle;
+    waiter.io        = io;
+    waiter.wake_fd   = fast_pipe_wake[1];
+    waiter.cancelled = FALSE;
+    server_enter_uninterrupted_section( &fast_pipe_mutex, &sigset );
+    list_add_tail( &fast_pipe_waiters, &waiter.entry );
+    fast_pipe_current = &waiter;
+    server_leave_uninterrupted_section( &fast_pipe_mutex, &sigset );
+
+    pfd[1].fd = fast_pipe_wake[0];
+    poll( pfd, 2, -1 );
+
+    server_enter_uninterrupted_section( &fast_pipe_mutex, &sigset );
+    list_remove( &waiter.entry );
+    fast_pipe_current = NULL;
+    server_leave_uninterrupted_section( &fast_pipe_mutex, &sigset );
+    while (read( fast_pipe_wake[0], &byte, 1 ) > 0) ;
+    return waiter.cancelled ? STATUS_CANCELLED : STATUS_SUCCESS;
+}
+
+/* Cancels the fast pipe I/O that thread `tid` (any thread if 0) waits for on
+ * `handle` (any handle if 0), only the one with `io` if given. */
+static BOOL fast_pipe_cancel( HANDLE tid, HANDLE handle, IO_STATUS_BLOCK *io )
+{
+    struct fast_pipe_waiter *waiter;
+    sigset_t sigset;
+    BOOL found = FALSE;
+
+    server_enter_uninterrupted_section( &fast_pipe_mutex, &sigset );
+    LIST_FOR_EACH_ENTRY( waiter, &fast_pipe_waiters, struct fast_pipe_waiter, entry )
+    {
+        if ((tid && waiter->tid != tid) || (handle && waiter->handle != handle)) continue;
+        if (io && waiter->io != io) continue;
+        waiter->cancelled = TRUE;
+        write( waiter->wake_fd, "", 1 );
+        found = TRUE;
+    }
+    server_leave_uninterrupted_section( &fast_pipe_mutex, &sigset );
+    return found;
+}
+
+/* Cleans up when the calling thread exits, also if it was terminated while
+ * waiting. */
+void fast_pipe_exit_thread(void)
+{
+    sigset_t sigset;
+
+    if (fast_pipe_current)
+    {
+        server_enter_uninterrupted_section( &fast_pipe_mutex, &sigset );
+        list_remove( &fast_pipe_current->entry );
+        fast_pipe_current = NULL;
+        server_leave_uninterrupted_section( &fast_pipe_mutex, &sigset );
+    }
+    if (fast_pipe_wake[0] == -1) return;
+    close( fast_pipe_wake[0] );
+    close( fast_pipe_wake[1] );
+    fast_pipe_wake[0] = fast_pipe_wake[1] = -1;
 }
 
