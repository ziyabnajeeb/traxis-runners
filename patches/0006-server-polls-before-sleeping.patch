+
+/* Traxis (patches/0006): how long the server keeps polling for the next
+ * event before it sleeps, after it handled one. Clients that make many
+ * requests in a row (installers' unpacking helpers) then find it awake;
+ * waking it costs ~5-10 us on macOS. WINESERVER_SPIN_US, 0 turns it off. */
+static long long server_spin_ns(void)
+{
+    static long long spin = -1;
+    if (spin < 0)
+    {
+        const char *env = getenv( "WINESERVER_SPIN_US" );
+        spin = (env ? atoll( env ) : 50) * 1000;
+    }
+    return spin;
+}
+
+static inline long long spin_clock_ns(void)
+{
+    struct timespec t;
+    clock_gettime( CLOCK_MONOTONIC, &t );
+    return t.tv_sec * 1000000000LL + t.tv_nsec;
 }
 
