+    unsigned int options;
+    NTSTATUS status;
+    BOOL checked_mode = FALSE;
+    ssize_t ret;
+
+    if ((status = server_get_pipe_unix_fd( handle, FILE_READ_DATA, &fd, &needs_close, &options )))
+        return status == STATUS_ACCESS_DENIED ? status : STATUS_BAD_DEVICE_TYPE;
+
+    for (;;)
+    {
+        if ((ret = virtual_locked_read( fd, buffer, length )) > 0 || (!ret && !length))
+        {
+            status = STATUS_SUCCESS;
+            break;
+        }
+        if (!ret)
+        {
+            status = STATUS_PIPE_BROKEN;
+            break;
+        }
+        if (errno == EINTR) continue;
+        if (errno == EAGAIN)
