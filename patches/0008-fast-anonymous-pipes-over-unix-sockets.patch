+static int is_create_pipe_name( const struct unicode_str *name )
+{
+    static const WCHAR prefix[] = {'W','i','n','3','2','.','P','i','p','e','s','.'};
+    data_size_t len = name->len / sizeof(WCHAR), start = len;
+
+    while (start && name->str[start - 1] != '\\') start--;
+    return len - start > ARRAY_SIZE(prefix) && !memcmp( name->str + start, prefix, sizeof(prefix) );
