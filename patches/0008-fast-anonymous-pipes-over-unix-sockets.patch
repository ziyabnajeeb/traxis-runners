+static void make_fast_pipe( struct named_pipe *pipe, struct pipe_server *server )
+{
+    int sv[2], i, on = 1, size = pipe->insize > 65536 ? pipe->insize : 65536;
+
+    if (socketpair( PF_UNIX, SOCK_STREAM, 0, sv ) == -1) return;
+    for (i = 0; i < 2; i++)
+    {
+        fcntl( sv[i], F_SETFL, O_NONBLOCK );
+#ifdef SO_NOSIGPIPE
+        setsockopt( sv[i], SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on) );
+#endif
+        setsockopt( sv[i], SOL_SOCKET, SO_SNDBUF, &size, sizeof(size) );
+        setsockopt( sv[i], SOL_SOCKET, SO_RCVBUF, &size, sizeof(size) );
+    }
+    set_fd_unix_fd( server->pipe_end.fd, sv[0] );
+    server->pipe_end.fast = 1;
+    pipe->fast_client_sock = sv[1];
+}
