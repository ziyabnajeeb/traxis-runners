+ * not at all in PIPE_NOWAIT mode); end of file means all handles to the other
+ * end are closed. */
+static NTSTATUS fast_pipe_read( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc_user,
+                                IO_STATUS_BLOCK *io, void *buffer, ULONG length )
+{
