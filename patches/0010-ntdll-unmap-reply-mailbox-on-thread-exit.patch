     close( fd );
     if (status) munmap( mailbox, sizeof(*mailbox) );
     else reply_mailbox = mailbox;
+}
+
+/* Traxis (patches/0010): releases the calling thread's reply mailbox when it
+ * exits, after its last server call. The server unmaps its own mapping when
+ * the thread object goes away. */
+void server_exit_thread(void)
+{
+    if (!reply_mailbox) return;
+    munmap( reply_mailbox, sizeof(*reply_mailbox) );
+    reply_mailbox = NULL;
 }
 
