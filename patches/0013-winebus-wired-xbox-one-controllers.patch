+/* XInput's vibration: grips (rumble = the heavy left motor, buzz = the
+ * light right one) and the trigger motors, 0-65535 each, to GIP's 0-100. */
+static NTSTATUS gip_device_haptics_start(struct unix_device *iface, UINT duration_ms,
+                                         USHORT rumble_intensity, USHORT buzz_intensity,
+                                         USHORT left_intensity, USHORT right_intensity)
+{
+    struct xbox_device *impl = impl_from_unix_device(iface);
+    UInt8 packet[] = {GIP_RUMBLE, 0x00, gip_next_seq(impl), 0x09, 0x00, 0x0f,
+                      left_intensity * 100 / 65535, right_intensity * 100 / 65535,
+                      rumble_intensity * 100 / 65535, buzz_intensity * 100 / 65535,
+                      0xff, 0x00, 0xff};
+
+    TRACE("iface %p, duration_ms %u, rumble %u, buzz %u, left %u, right %u.\n", iface, duration_ms,
+          rumble_intensity, buzz_intensity, left_intensity, right_intensity);
+    if (!impl->interface) return STATUS_DEVICE_NOT_READY;
+    gip_send(impl, packet, sizeof(packet));
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS gip_device_haptics_stop(struct unix_device *iface)
+{
+    return gip_device_haptics_start(iface, 0, 0, 0, 0, 0);
+}
