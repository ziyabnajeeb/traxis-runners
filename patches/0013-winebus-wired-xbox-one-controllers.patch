+/* A gamepad as XInput expects one, with grip and trigger haptics. */
+static BOOL gip_build_report_descriptor(struct unix_device *iface)
+{
+    static const USAGE_AND_PAGE device_usage = {.UsagePage = HID_USAGE_PAGE_GENERIC,
+                                                .Usage = HID_USAGE_GENERIC_GAMEPAD};
+
+    return hid_device_begin_report_descriptor(iface, &device_usage) &&
+           hid_device_add_gamepad(iface) && hid_device_add_haptics(iface) &&
+           hid_device_end_report_descriptor(iface);
+}
