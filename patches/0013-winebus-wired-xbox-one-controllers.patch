+/* Traxis (patches/0013): GIP, as the Linux xpad driver documents it. */
+enum { GIP_ACK = 0x01, GIP_POWER = 0x05, GIP_GUIDE = 0x07, GIP_RUMBLE = 0x09, GIP_INPUT = 0x20 };
+#define GIP_OPT_ACK      0x10
+#define GIP_OPT_INTERNAL 0x20
+
+/* Wired pads that speak GIP (Bluetooth models never reach this USB bus). */
+static BOOL is_gip_gamepad(WORD vid, WORD pid)
+{
+    return vid == 0x045e && (pid == 0x02d1 || pid == 0x02dd || pid == 0x02e3 || pid == 0x02ea ||
+                             pid == 0x0b00 || pid == 0x0b12);
+}
+
+/* The next sequence number: they start at 1, and the pad ignores a power-on
+ * numbered 0. */
+static UInt8 gip_next_seq(struct xbox_device *impl)
+{
+    if (!++impl->gip_seq) impl->gip_seq = 1;
+    return impl->gip_seq;
+}
+
+static void gip_send(struct xbox_device *impl, const UInt8 *data, UInt32 size)
+{
+    IOReturn ret = (*impl->interface)->WritePipe(impl->interface, impl->out_pipe, (void *)data, size);
+    if (ret != kIOReturnSuccess) WARN("write failed, %#x\n", ret);
+}
+
+/* Wakes the pad: it sends nothing until told to power on. The One S and
+ * Elite 2 also need their own start packet. */
+static void gip_start(struct xbox_device *impl, WORD pid)
+{
+    UInt8 power_on[] = {GIP_POWER, GIP_OPT_INTERNAL, gip_next_seq(impl), 0x01, 0x00};
+    UInt8 s_init[] = {GIP_POWER, GIP_OPT_INTERNAL, gip_next_seq(impl), 0x0f, 0x06};
+
+    gip_send(impl, power_on, sizeof(power_on));
+    if (pid == 0x02ea || pid == 0x0b00) gip_send(impl, s_init, sizeof(s_init));
+}
+
+/* Buttons as hid_device_add_gamepad numbers them (the SDL bus's order). */
+enum { PAD_A, PAD_B, PAD_X, PAD_Y, PAD_LB, PAD_RB, PAD_BACK, PAD_START, PAD_LS, PAD_RS,
+       PAD_UP, PAD_RIGHT, PAD_DOWN, PAD_LEFT, PAD_GUIDE = 16 };
+
+static void gip_read(struct unix_device *device, const UInt8 *data, UInt32 size)
+{
+    struct xbox_device *impl = impl_from_unix_device(device);
+    struct hid_device_state *state = &device->hid_device_state;
+
+    if (size >= 18 && data[0] == GIP_INPUT)
+    {
+        /* GIP: byte 4 menu, view, A, B, X, Y in bits 2-7; byte 5 d-pad up,
+         * down, left, right, LB, RB, stick clicks; triggers 0-1023 at 6 and
+         * 8; sticks at 10-16 with Y up, as XInput has them. */
+        static const struct { BYTE byte, mask, button; } map[] =
+        {
+            {4, 0x04, PAD_START}, {4, 0x08, PAD_BACK}, {4, 0x10, PAD_A}, {4, 0x20, PAD_B},
+            {4, 0x40, PAD_X}, {4, 0x80, PAD_Y}, {5, 0x01, PAD_UP}, {5, 0x02, PAD_DOWN},
+            {5, 0x04, PAD_LEFT}, {5, 0x08, PAD_RIGHT}, {5, 0x10, PAD_LB}, {5, 0x20, PAD_RB},
+            {5, 0x40, PAD_LS}, {5, 0x80, PAD_RS},
+        };
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(map); i++)
+            hid_device_set_button(device, map[i].button, data[map[i].byte] & map[i].mask);
+        hid_device_set_hatswitch_x(device, 0, !!(data[5] & 0x08) - !!(data[5] & 0x04));
+        hid_device_set_hatswitch_y(device, 0, !!(data[5] & 0x02) - !!(data[5] & 0x01));
+        hid_device_set_abs_axis(device, 0, (SHORT)(data[10] | data[11] << 8));
+        hid_device_set_abs_axis(device, 1, (SHORT)(data[12] | data[13] << 8));
+        hid_device_set_abs_axis(device, 2, (SHORT)(data[14] | data[15] << 8));
+        hid_device_set_abs_axis(device, 3, (SHORT)(data[16] | data[17] << 8));
+        /* triggers: 0-1023 to the descriptor's 0-32767 */
+        hid_device_set_abs_axis(device, 4, (data[6] | data[7] << 8) * 32);
+        hid_device_set_abs_axis(device, 5, (data[8] | data[9] << 8) * 32);
+    }
+    else if (size >= 5 && data[0] == GIP_GUIDE)
+    {
+        /* The pad repeats this report until it is acknowledged, and then
+         * stops reporting the button. */
+        if (data[1] == (GIP_OPT_ACK | GIP_OPT_INTERNAL))
+        {
+            UInt8 ack[] = {GIP_ACK, GIP_OPT_INTERNAL, data[2], 0x09, 0x00, GIP_GUIDE,
+                           GIP_OPT_INTERNAL, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00};
+            gip_send(impl, ack, sizeof(ack));
+        }
+        hid_device_set_button(device, PAD_GUIDE, data[4] & 0x03);
+    }
+    else return;
+
+    bus_event_queue_input_report(&event_queue, device, state->report_buf, state->report_len);
+}
