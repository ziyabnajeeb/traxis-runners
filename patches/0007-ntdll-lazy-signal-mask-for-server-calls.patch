+/***********************************************************************
+ *           server_defer_signal
+ *
+ * Called first by the handlers of signals in server_block_set, with the
+ * interrupted context's mask. Returns TRUE if the handler must return now.
  */
+BOOL server_defer_signal( int signal, sigset_t *handler_mask )
+{
+    struct ntdll_thread_data *data = ntdll_get_thread_data();
+    int i;
+
+    if (!data->server_section) return FALSE;
+    if (!data->deferred_signal)
+    {
+        data->deferred_mask = *handler_mask;
+        data->deferred_signal = 1;
+    }
+    for (i = 1; i < NSIG; i++)
+        if (sigismember( &server_block_set, i )) sigaddset( handler_mask, i );
+    pthread_kill( pthread_self(), signal );
+    return TRUE;
+}
