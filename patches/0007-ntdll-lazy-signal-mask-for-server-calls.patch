+/* Traxis (patches/0007): instead of blocking server_block_set around every
+ * server call (two system calls, ~0.9 us on macOS), count the calls the thread
+ * is in. A handler for one of those signals that arrives meanwhile defers
+ * itself (server_defer_signal): it blocks them in the interrupted context and
+ * queues the signal again, and server_section_leave restores the mask, which
+ * delivers it. Same order as with blocking, paid only when a signal comes.
+ * WINE_LAZY_SIGMASK=0 turns it off. */
+BOOL server_lazy_sigmask = TRUE;
+
+static inline void server_section_enter( sigset_t *old_set )
+{
+    if (!server_lazy_sigmask)
+    {
+        pthread_sigmask( SIG_BLOCK, &server_block_set, old_set );
+        return;
+    }
+    ntdll_get_thread_data()->server_section++;
+    __atomic_signal_fence( __ATOMIC_SEQ_CST );
+}
+
+static inline void server_section_leave( const sigset_t *old_set )
+{
+    struct ntdll_thread_data *data;
+
+    if (!server_lazy_sigmask)
+    {
+        pthread_sigmask( SIG_SETMASK, old_set, NULL );
+        return;
+    }
+    data = ntdll_get_thread_data();
+    __atomic_signal_fence( __ATOMIC_SEQ_CST );
+    if (--data->server_section || !data->deferred_signal) return;
+    data->deferred_signal = 0;
+    pthread_sigmask( SIG_SETMASK, &data->deferred_mask, NULL );
+}
