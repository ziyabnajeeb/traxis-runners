# Runner manifest (architecture §5.4). Filled in by scripts/package.sh.
schema_version = 1
id = "@ID@"
version = "@VERSION@"
wine = "bin/wine"
wineserver = "bin/wineserver"
runtimes = ["rosetta"]
source_url = "@SOURCE_URL@"
addons = [@ADDONS@]

[env]
# Wine loads FreeType and friends by bare name; find them in the runner itself.
DYLD_FALLBACK_LIBRARY_PATH = "{runner}/lib:/usr/local/lib:/usr/lib"
# GStreamer (Media Foundation video and audio) uses only the runner's plugins,
# with its own registry cache.
GST_PLUGIN_SYSTEM_PATH_1_0 = "{runner}/lib/gstreamer-1.0"
GST_PLUGIN_PATH_1_0 = ""
GST_PLUGIN_SCANNER_1_0 = "{runner}/libexec/gstreamer-1.0/gst-plugin-scanner"
GST_REGISTRY_1_0 = "{runner}/lib/gstreamer-1.0/registry.bin"
